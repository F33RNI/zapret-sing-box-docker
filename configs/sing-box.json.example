{
    "$schema": "https://sing-box.sagernet.org/schema.json",

    // Logs redirected to the file by container's sript, so don't specify any file here
    "log": { "disabled": false, "level": "info", "timestamp": true },

    // DNS servers
    "dns": {
        "servers": [
            // Add your other DNS servers here if needed

            // System DNS (should be dnscrypt-proxy)
            { "type": "local", "tag": "local" }
        ],

        // Try "ipv4_only" if needed
        "strategy": "prefer_ipv4",

        // Disable cache because dnscrypt-proxy handles it
        "disable_cache": true
    },

    // This is how you can connect to the container. Please don't forget to specify ports to the ./start script
    "inbounds": [
        // SOCKS4 + SOCKS5 + HTTP proxy
        {
            "type": "mixed",
            "tag": "mixed-in",
            "listen": "0.0.0.0",
            "listen_port": 2080,
            "reuse_addr": true,
            "tcp_fast_open": true,
            "tcp_multi_path": true,
            "udp_fragment": false
        }
    ],

    // Direct means via zapret
    "outbounds": [{ "type": "direct", "tag": "direct" }],

    "route": {
        "rules": [
            // DNS
            { "action": "sniff" },
            { "protocol": "dns", "action": "hijack-dns" },

            // Localhost
            { "ip_cidr": ["127.0.0.0/8"], "action": "reject" },

            // Localnet
            { "ip_cidr": ["10.0.0.0/24", "192.168.0.0/16"], "action": "reject" }

            // Add ADs and tracking block / other rules here if needed
        ],
        "final": "direct",
        "default_domain_resolver": "local",
        "auto_detect_interface": true
    }
}
